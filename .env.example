# Integral Pro server configuration. Copy to .env for local use.
# The server does not load .env automatically — export these or use your
# process manager / docker compose. The Vite dev server ignores them.

# Port for the API, terminal WebSocket and production frontend.
PORT=8787

# Interface to bind. The default is loopback-only. Containers need 0.0.0.0
# internally, but publish that port to 127.0.0.1 on the host.
# HOST=127.0.0.1

# Require this token before the workspace is accessible. Strongly recommended
# on any host reachable by other machines. Stored in the browser after login.
# ACCESS_TOKEN=change-me

# Point the IDE at an existing project. When unset, Integral Pro uses
# ./data/workspace and seeds it with the demo project on first boot.
# WORKSPACE_DIR=/absolute/path/to/project

# SQLite index and runtime data. Defaults to ./data.
# DATA_DIR=/absolute/path/to/data
